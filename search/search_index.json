{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#kaplan-business-school-diploma","title":"\u6fb3\u5927\u5229\u4e9a\u5361\u666e\u5170\u5546\u5b66\u9662\u5b66\u4f4d\u8bc1\u4e66\uff08Kaplan Business School diploma\uff09\u89c6\u89c9\u6784\u67b6\u4e0e\u5b98\u65b9\u9632\u4f2a\u7279\u5f81\u6838\u9a8c","text":"<p>\u5728\u5f53\u4eca\u5168\u7403\u5316\u5546\u4e1a\u4eba\u624d\u7684\u62db\u52df\u4e0e\u9009\u62d4\u4e2d\uff0c\u5bf9\u6d77\u5916\u9ad8\u7b49\u6559\u80b2\u80cc\u666f\u7684\u771f\u5b9e\u6027\u8bc4\u4f30\u5df2\u6210\u4e3a\u4eba\u529b\u8d44\u6e90\u90e8\u95e8\u4e0e\u5408\u89c4\u6838\u67e5\u673a\u6784\u7684\u65e5\u5e38\u6838\u5fc3\u5de5\u4f5c\u3002\u6fb3\u5927\u5229\u4e9a\u5361\u666e\u5170\u5546\u5b66\u9662\uff08Kaplan Business School\uff0c\u7b80\u79f0 KBS\uff09\u4f5c\u4e3a\u5728\u5168\u7403\u9ad8\u7b49\u6559\u80b2\u53ca\u804c\u4e1a\u57f9\u8bad\u9886\u57df\u4eab\u6709\u76db\u8a89\u7684\u5b66\u672f\u673a\u6784\uff0c\u5176\u9881\u53d1\u7684\u7855\u58eb\u53ca\u5b66\u58eb\u5b66\u4f4d\u8bc1\u4e66\u5728\u56fd\u9645\u5546\u4e1a\u5e02\u573a\u4e2d\u5177\u6709\u6781\u9ad8\u7684\u8ba4\u53ef\u5ea6\u3002</p> <p></p> <p>\u4e3a\u4e86\u6ee1\u8db3\u4f01\u4e8b\u4e1a\u5355\u4f4d\u5728\u4eba\u624d\u5f15\u8fdb\u65f6\u7684\u5b66\u5386\u80cc\u666f\u6838\u67e5\u9700\u6c42\uff0c\u672c\u6587\u5c06\u4ee5\u5361\u666e\u5170\u5546\u5b66\u9662\u5b98\u65b9\u6807\u51c6\u7684\u5546\u79d1\u7855\u58eb\u5b66\u4f4d\u8bc1\u4e66\u771f\u5b9e\u6837\u672c\u4e3a\u53c2\u7167\uff0c\u4ece\u8bc1\u4e66\u7684\u6574\u4f53\u7248\u9762\u8bbe\u8ba1\u3001\u6838\u5fc3\u89c6\u89c9\u6807\u8bc6\u3001\u6587\u672c\u5c42\u7ea7\u903b\u8f91\u4ee5\u53ca\u5e95\u90e8\u9632\u4f2a\u9632\u5047\u6807\u8bc6\u7b49\u7ef4\u5ea6\u8fdb\u884c\u591a\u7ef4\u5ea6\u7684\u72ec\u5bb6\u62c6\u89e3\u3002</p>"},{"location":"#_1","title":"\u5361\u666e\u5170\u5546\u5b66\u9662\u8bc1\u4e66\u7684\u6574\u4f53\u8bbe\u8ba1\u7f8e\u5b66","text":"<p>\u6709\u522b\u4e8e\u6fb3\u6d32\u4f20\u7edf\u516c\u7acb\u5927\u5b66\u504f\u7231\u7684\u53e4\u5178\u539a\u91cd\u98ce\u683c\uff0c\u5361\u666e\u5170\u5546\u5b66\u9662\u7684\u5b66\u4f4d\u8bc1\u4e66\u5728\u89c6\u89c9\u4e0a\u660e\u663e\u5e26\u6709\u73b0\u4ee3\u5546\u4e1a\u793e\u4f1a\u7684\u5e72\u7ec3\u3001\u7cbe\u81f4\u4e0e\u6570\u5b57\u5316\u7f8e\u5b66\u7279\u5f81\u3002\u6574\u4e2a\u8bc1\u4e66\u91c7\u7528\u7eb5\u5411\u6807\u51c6A4\u7248\u9762\uff0c\u9009\u7528\u9ad8\u767d\u5ea6\u3001\u9ad8\u5e73\u6574\u5ea6\u7684\u7279\u79cd\u6d82\u5e03\u8bc1\u5238\u7eb8\u5f20\u5370\u5237\uff0c\u89e6\u611f\u7ec6\u817b\u4e14\u5177\u6709\u4e00\u5b9a\u7684\u633a\u5ea6\u3002</p> <p>\u5728\u8272\u5f69\u642d\u914d\u4e0a\uff0c\u8bc1\u4e66\u4ee5\u5361\u666e\u5170\u96c6\u56e2\u6807\u5fd7\u6027\u7684\u7687\u5bb6\u84dd\uff08Royal Blue\uff09\u4f5c\u4e3a\u4e3b\u57fa\u8c03\u3002\u6574\u4e2a\u7248\u9762\u7684\u6700\u5916\u5c42\u5305\u88f9\u7740\u4e00\u9053\u7cbe\u7ec6\u7684\u84dd\u8272\u77e9\u5f62\u8fb9\u6846\uff0c\u540c\u65f6\u80cc\u666f\u4e2d\u878d\u5165\u4e86\u6de1\u84dd\u8272\u7684\u534a\u900f\u660e\u6d41\u7ebf\u578b\u6697\u7eb9\uff0c\u8fd9\u79cd\u51b7\u8272\u8c03\u7684\u7ec4\u5408\u65e2\u5f70\u663e\u4e86\u5546\u5b66\u9662\u7684\u4e25\u8c28\u4e0e\u7406\u6027\uff0c\u53c8\u901a\u8fc7\u590d\u6742\u7684\u80cc\u666f\u5e95\u7eb9\u63d0\u5347\u4e86\u6587\u4ef6\u7684\u9632\u4f2a\u95e8\u69db\u3002</p>"},{"location":"#_2","title":"\u9876\u90e8\u5b98\u65b9\u5fbd\u6807\u4e0e\u5b66\u672f\u59d4\u5458\u4f1a\u5ba3\u544a\u8bcd\u6838\u5bf9","text":"<p>\u8bc1\u4e66\u7684\u4e0a\u534a\u90e8\u5206\u662f\u5b66\u6821\u5408\u6cd5\u8eab\u4efd\u7684\u96c6\u4e2d\u5c55\u73b0\u533a\uff0c\u5305\u542b\u5b66\u6821\u7684\u6838\u5fc3\u54c1\u724c\u6807\u8bc6\u4ee5\u53ca\u6388\u4e88\u673a\u6784\u7684\u6cd5\u7406\u5ba3\u544a\u3002</p>"},{"location":"#1-the-brand-logo","title":"1. \u5b98\u65b9\u54c1\u724c\u5fbd\u6807\uff08The Brand Logo\uff09","text":"<p>\u5728\u9875\u9762\u6b63\u4e0a\u65b9\u5c45\u4e2d\u4f4d\u7f6e\uff0c\u5370\u6709\u6e05\u6670\u7684\u201cKAPLAN\u201d\u54c1\u724c\u6807\u8bc6\u3002 * \u56fe\u5f62\u7279\u5f81\uff1a \u201cKAPLAN\u201d\u5b57\u6837\u91c7\u7528\u5176\u6807\u5fd7\u6027\u7684\u6df1\u84dd\u8272\u65e0\u886c\u7ebf\u73b0\u4ee3\u5b57\u4f53\uff0c\u5728\u5b57\u6bcd\u201cN\u201d\u7684\u53f3\u4e0a\u89d2\u5ef6\u4f38\u51fa\u4e00\u9053\u4f18\u96c5\u7684\u5f27\u7ebf\uff0c\u72b9\u5982\u4e00\u9053\u84dd\u8272\u7684\u6781\u5149\u6216\u98de\u7ffc\uff0c\u6781\u5177\u8fa8\u8bc6\u5ea6\u3002 * \u9644\u5c5e\u6587\u672c\uff1a \u54c1\u724c\u6807\u8bc6\u4e0b\u65b9\u7d27\u63a5\u7740\u4e24\u884c\u5927\u5199\u7684\u7070\u8272\u6216\u6df1\u84dd\u8272\u9644\u5c5e\u5b57\u6837\uff1a\u201cBUSINESS SCHOOL\u201d\u4e0e\u201cAUSTRALIA\u201d\uff0c\u660e\u786e\u4e86\u8be5\u8bc1\u4e66\u9881\u53d1\u673a\u6784\u7684\u5177\u4f53\u5b9e\u4f53\u3002 * \u6838\u9a8c\u7ec6\u8282\uff1a \u771f\u5b9e\u6837\u672c\u4e2d\uff0c\u8be5\u5fbd\u6807\u7684\u5370\u5237\u5957\u8272\u6781\u5176\u7cbe\u51c6\uff0c\u5f27\u7ebf\u4e0e\u5b57\u6bcd\u7684\u4ea4\u63a5\u5904\u8fb9\u7f18\u65e0\u4efb\u4f55\u6cb9\u58a8\u6ea2\u51fa\u6216\u8fb9\u7f18\u53d1\u865a\u7684\u73b0\u8c61\u3002</p>"},{"location":"#2-the-conferred-date","title":"2. \u7b7e\u7f72\u4e0e\u9881\u53d1\u65e5\u671f\u524d\u7f6e\uff08The Conferred Date\uff09","text":"<p>\u5728\u4f20\u7edf\u8bc1\u4e66\u4e2d\uff0c\u65e5\u671f\u901a\u5e38\u4f4d\u4e8e\u6700\u5e95\u90e8\uff0c\u800cKBS\u7684\u8bc1\u4e66\u5c06\u5176\u8fdb\u884c\u4e86\u524d\u7f6e\u3002\u5728\u5fbd\u6807\u4e0b\u65b9\uff0c\u5370\u6709\u8bf4\u660e\u8bcd\uff1a\u201cConferred by the Kaplan Business School Academic Board\u201d\uff08\u7531\u5361\u666e\u5170\u5546\u5b66\u9662\u5b66\u672f\u59d4\u5458\u4f1a\u6388\u4e88\uff09\u3002\u7d27\u63a5\u7740\u4ee5\u5927\u53f7\u9ed1\u4f53\u5b57\u76f4\u63a5\u6253\u5370\u51fa\u5177\u4f53\u7684\u6388\u4e88\u65f6\u95f4\uff0c\u4f8b\u5982\u6837\u672c\u4e2d\u7684\u201c01 August 2025\u201d\uff082025\u5e748\u67081\u65e5\uff09\uff0c\u8fd9\u4e0e\u9875\u9762\u6700\u53f3\u4e0a\u89d2\u7ec6\u5c0f\u7684\u751f\u6210\u65e5\u671f\uff08Date Generated\uff09\u4e92\u4e3a\u547c\u5e94\u3002</p>"},{"location":"#_3","title":"\u6838\u5fc3\u4fe1\u606f\u533a\u57df\u4e0e\u5546\u79d1\u4e13\u4e1a\u6587\u672c\u5c42\u7ea7","text":"<p>\u8bc1\u4e66\u7684\u4e2d\u592e\u6838\u5fc3\u533a\u57df\u662f\u5173\u4e8e\u6bd5\u4e1a\u751f\u4e2a\u4eba\u8eab\u4efd\u53ca\u6240\u83b7\u5b66\u672f\u8363\u8a89\u7684\u6cd5\u5b9a\u8bb0\u8f7d\uff0c\u5b57\u4f53\u7684\u5c42\u6b21\u611f\u4e0e\u95f4\u8ddd\u6392\u7248\u6781\u4e3a\u8bb2\u7a76\u3002</p>"},{"location":"#1","title":"1. \u5f15\u5bfc\u8bcd\u4e0e\u59d3\u540d\u6392\u7248","text":"<p>\u5728\u65e5\u671f\u4e0b\u65b9\uff0c\u662f\u4e00\u884c\u7cbe\u7ec6\u7684\u8fc7\u6e21\u6587\u672c\u201cThis is to certify that\u201d\uff08\u7279\u6b64\u8bc1\u660e\uff09\uff0c\u7d27\u63a5\u7740\u662f\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u5168\u79f0\u3002\u59d3\u540d\u90e8\u5206\u5728\u5b9e\u4ef6\u4e2d\u62e5\u6709\u72ec\u7acb\u7684\u5b57\u53f7\u548c\u52a0\u7c97\u5904\u7406\uff0c\u4e0e\u80cc\u666f\u7684\u6d41\u7ebf\u578b\u6697\u7eb9\u5b8c\u7f8e\u878d\u5408\uff0c\u65e2\u4fdd\u8bc1\u4e86\u540d\u5b57\u7684\u9192\u76ee\uff0c\u53c8\u901a\u8fc7\u5e95\u7eb9\u589e\u52a0\u4e86\u6574\u4f53\u6587\u4ef6\u7684\u590d\u5370\u96be\u5ea6\u3002</p>"},{"location":"#2-degree-and-extension","title":"2. \u5b66\u4f4d\u540d\u79f0\u4e0e\u4e13\u4e1a\u65b9\u5411\uff08Degree and Extension\uff09","text":"<p>\u59d3\u540d\u4e0b\u65b9\u901a\u8fc7\u77ed\u53e5\u201chas fulfilled the requirements for\u201d\uff08\u5df2\u6ee1\u8db3\u76f8\u5173\u8981\u6c42\uff09\u5f15\u51fa\u6838\u5fc3\u5b66\u4f4d\uff1a * Master of Business Analytics (Extension) \uff08\u5546\u4e1a\u5206\u6790\u7855\u58eb - \u5ef6\u4f38/\u62d3\u5c55\u65b9\u5411\uff09 * \u6392\u7248\u7279\u5f81\uff1a \u8be5\u5b66\u4f4d\u540d\u79f0\u91c7\u7528\u6807\u51c6\u7684\u9ad8\u6e05\u9ed1\u8272\u5b57\u4f53\u6253\u5370\uff0c\u5de6\u53f3\u8de8\u5ea6\u8f83\u5927\uff0c\u51e0\u4e4e\u6a2a\u8de8\u6574\u4e2a\u7248\u9762\u3002\u5176\u4e2d\uff0c\u4e13\u4e1a\u65b9\u5411\u7684\u62ec\u53f7\u548c\u201cExtension\u201d\u5b57\u6837\u7684\u5b57\u4f53\u7c97\u7ec6\u3001\u95f4\u8ddd\u5747\u7ecf\u8fc7\u6570\u5b57\u5316\u7cbe\u5bc6\u6392\u7248\uff0c\u6574\u4f53\u89c6\u89c9\u91cd\u5fc3\u7a33\u5c45\u6574\u4e2a\u84dd\u8272\u5916\u8fb9\u6846\u7684\u51e0\u4f55\u4e2d\u5fc3\u8f74\u7ebf\u4e0a\u3002</p>"},{"location":"#_4","title":"\u5e95\u90e8\u5b98\u65b9\u7b7e\u7ae0\u4e0e\u5168\u606f\u9632\u4f2a\u5fbd\u7ae0\u6bd4\u5bf9","text":"<p>\u8bc1\u4e66\u7684\u5de6\u4e0b\u89d2\u4e0e\u53f3\u4e0b\u89d2\u627f\u8f7d\u7740\u8bc1\u4e66\u7684\u6cd5\u5f8b\u6548\u529b\uff0c\u662f\u5224\u65ad\u6587\u4ef6\u771f\u4f2a\u7684\u6838\u5fc3\u6280\u672f\u8282\u70b9\u3002</p>"},{"location":"#1-official-signature","title":"1. \u9996\u5e2d\u6267\u884c\u5b98\u6cd5\u5b9a\u7b7e\u7ae0\uff08Official Signature\uff09","text":"<p>\u5728\u5de6\u4e0b\u89d2\uff0c\u5370\u6709\u5361\u666e\u5170\u5546\u5b66\u9662\u6700\u9ad8\u884c\u653f\u957f\u5b98\u7684\u6cd5\u5b9a\u7b7e\u540d\uff1a * \u4fe1\u606f\u5bf9\u9f50\uff1a \u7b7e\u540d\u4e0b\u65b9\u6e05\u6670\u5370\u6709\u201cRob Regan / Principal Executive Officer / Kaplan Business School\u201d\u7b49\u4e09\u884c\u804c\u4f4d\u804c\u79f0\u4fe1\u606f\u3002 * \u6846\u67b6\u5ba3\u544a\uff1a \u5728\u7b7e\u540d\u533a\u6700\u4e0b\u65b9\uff0c\u8fd8\u9644\u5e26\u6709\u4e00\u884c\u6781\u4e3a\u91cd\u8981\u7684\u5fae\u7f29\u6cd5\u5f8b\u5ba3\u544a\uff1a\u201cThe qualification is recognised within the Australian Qualifications Framework\u201d\uff08\u8be5\u5b66\u5386\u5728\u6fb3\u5927\u5229\u4e9a\u5b66\u5386\u8d44\u683c\u6846\u67b6\u5185\u83b7\u5f97\u8ba4\u53ef\uff09\u3002</p>"},{"location":"#2-kthe-corporate-seal","title":"2. \u7070\u8272\u9f7f\u8f6e\u72b6\u201cK\u201d\u5b57\u9632\u4f2a\u5fbd\u7ae0\uff08The Corporate Seal\uff09","text":"<p>\u53f3\u4e0b\u89d2\u5bf9\u5e94\u52a0\u76d6\u6709\u4e00\u4e2a\u6781\u5177\u79d1\u6280\u611f\u7684\u5706\u5f62\u9f7f\u8f6e\u72b6\u5b66\u672f\u9632\u4f2a\u5370\u7ae0\u3002 * \u89c6\u89c9\u7279\u5f81\uff1a \u8be5\u5370\u7ae0\u4e3a\u7070\u8272\uff0c\u5916\u5708\u7531\u7ec6\u5bc6\u7684\u653e\u5c04\u72b6\u9f7f\u8f6e\u6ce2\u7eb9\u6784\u6210\uff0c\u5185\u5708\u662f\u4e00\u4e2a\u5de8\u5927\u7684\u5927\u5199\u5b57\u6bcd\u201cK\u201d\uff0c\u4ee3\u8868\u5361\u666e\u5170\uff08Kaplan\uff09\u7684\u9996\u5b57\u6bcd\u3002 * \u9632\u4f2a\u5de5\u827a\uff1a \u5728\u771f\u5b9e\u7684\u7eb8\u8d28\u539f\u4ef6\u4e0a\uff0c\u8fd9\u4e00\u5fbd\u7ae0\u533a\u57df\u901a\u5e38\u7ed3\u5408\u4e86\u6781\u7ec6\u7684\u5fae\u7f29\u7ebf\u6761\u5370\u5237\u4ee5\u53ca\u7279\u5b9a\u89d2\u5ea6\u4e0b\u7684\u6298\u5149\u6280\u672f\uff0c\u4f7f\u5176\u5728\u9ad8\u6e05\u590d\u5370\u6216\u626b\u63cf\u65f6\u6781\u6613\u56e0\u8272\u5f69\u5931\u771f\u6216\u7ebf\u6761\u7c98\u8fde\u800c\u9732\u51fa\u7834\u7efd\u3002 * \u5e95\u90e8\u811a\u6ce8\uff1a \u5728\u6574\u4e2a\u84dd\u8272\u8fb9\u6846\u4e4b\u5916\u7684\u6700\u5e95\u90e8\uff0c\u4ee5\u6781\u5c0f\u5b57\u53f7\u5b8c\u6574\u5370\u5237\u4e86\u5361\u666e\u5170\u5546\u5b66\u9662\u4f5c\u4e3a\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u673a\u6784\u7684\u6cd5\u5b9a\u6ce8\u518c\u4ee3\u7801\uff08\u5982PRV12094\u3001ABN\u3001CRICOS\u63d0\u4f9b\u5546\u4ee3\u780102426B\u7b49\uff09\uff0c\u5f62\u6210\u4e86\u4e25\u5bc6\u7684\u6cd5\u7406\u95ed\u73af\u3002</p>"},{"location":"#_5","title":"\u603b\u7ed3","text":"<p>\u5bf9\u5361\u666e\u5170\u5546\u5b66\u9662\u6bd5\u4e1a\u8bc1\uff08KBS Diploma\uff09\u7684\u53c2\u7167\u4e0e\u6838\u9a8c\uff0c\u9700\u8981\u7d27\u6263\u5176\u73b0\u4ee3\u5546\u4e1a\u7f8e\u5b66\u7684\u6392\u7248\u903b\u8f91\u3002\u4ece\u6700\u5916\u5c42\u7684\u7687\u5bb6\u84dd\u7cbe\u7ec6\u8fb9\u6846\uff0c\u5230\u9876\u90e8\u7684\u98de\u7ffc\u5f27\u7ebf\u5fbd\u6807\uff0c\u518d\u5230\u5de6\u4e0b\u89d2\u4e25\u683c\u9075\u5faaAQF\u6559\u80b2\u6846\u67b6\u7684\u6cd5\u5f8b\u5ba3\u544a\uff0c\u4ee5\u53ca\u53f3\u4e0b\u89d2\u6807\u5fd7\u6027\u7684\u7070\u8272\u201cK\u201d\u5b57\u9f7f\u8f6e\u9632\u4f2a\u5fbd\u7ae0\uff0c\u8fd9\u4e9b\u65e0\u4e00\u4e0d\u4f53\u73b0\u51fa\u8be5\u6821\u6570\u5b57\u5316\u3001\u6807\u51c6\u5316\u7684\u6559\u5b66\u7ba1\u7406\u4f53\u7cfb\u3002\u6df1\u5165\u638c\u63e1\u8fd9\u4e9b\u7279\u6709\u7684\u89c6\u89c9\u8282\u70b9\uff0c\u4e0d\u4ec5\u80fd\u591f\u5e2e\u52a9\u7528\u4eba\u5355\u4f4d\u5efa\u7acb\u9ad8\u6548\u7684\u6587\u51ed\u521d\u5ba1\u673a\u5236\uff0c\u4e5f\u80fd\u66f4\u597d\u5730\u4fdd\u969c\u6d77\u5f52\u5546\u4e1a\u4eba\u624d\u7684\u5408\u6cd5\u6743\u76ca\u3002\u9632\u4f2a\u7ec6\u8282\uff0c\u80fd\u591f\u4e3a\u6d77\u5f52\u4eba\u624d\u7684\u8eab\u4efd\u6838\u9a8c\u4e0e\u7528\u4eba\u5355\u4f4d\u7684\u98ce\u9669\u9632\u8303\u63d0\u4f9b\u575a\u5b9e\u7684\u6280\u672f\u652f\u6491\u3002</p>"}]}